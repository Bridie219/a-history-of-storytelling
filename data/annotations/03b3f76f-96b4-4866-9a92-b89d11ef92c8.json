      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "Mr Darcy's attraction to Elizabeth is undeniable. Every time she enters the room, all of his attention is immediately focused on her. She feels rather uncomfortable from his attention, because she doesn't understand what it means. "
            }
          ]
        }
      ],
      "tags": [],
