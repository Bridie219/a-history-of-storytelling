    },
    {
      "start_time": 79,
      "end_time": 97,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "Further establishes society with Mrs Bennett being eager to introduce her daughters to the two eligible men, in hopes of securing a prosperous marriage for them. "
            }
          ]
        }
      ],
