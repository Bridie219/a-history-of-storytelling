    },
    {
      "start_time": 279,
      "end_time": 297,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "Charlotte and Jane mock Mr Darcy, and Jane decides he is the last man she would ever dance with. This becomes relevant when she says a similar thing to Mr Darcy during his proposal. "
            }
          ]
        }
      ],
