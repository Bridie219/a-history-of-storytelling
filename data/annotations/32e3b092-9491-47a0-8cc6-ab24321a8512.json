    {
      "start_time": 66,
      "end_time": 79,
      "annotation": [
        {
          "type": "paragraph",
          "children": [
            {
              "text": "A brief meeting of eyes between Elizabeth and Mr Darcy, where Mr Darcy appears briefly shocked to have noticed Elizabeth, and Elizabeth seems a little pleased to have captured his attention. "
            }
          ]
        }
      ],
